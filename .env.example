# Application database: Aiven PostgreSQL
DB_URL=jdbc:postgresql://<aiven-host>:<aiven-port>/defaultdb?sslmode=require
DB_USER=avnadmin
DB_PASSWORD=<aiven-password>

# Supabase (login only)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# Browser origins allowed to call the API (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# AI service (private)
AI_SERVICE_BASE_URL=http://localhost:8000
AI_INTERNAL_TOKEN=change-me-to-a-long-random-value

# Payments and calls
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
CALL_ROOM_SECRET=

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
